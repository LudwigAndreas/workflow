// GitOps repo (gitops_backend, gitops_frontend) - the Argo CD repository.
//
// Multibranch pipeline over main. Every push that lands an overlay change is
// observed: wait for Argo, tell Jira, revert if the sync degrades.
//
// The *promotion* half is a separate parameterised job - see
// examples/Jenkinsfile.promote - because it is always triggered externally.

@Library('sdd-workflow@main') _

sddObserve()
